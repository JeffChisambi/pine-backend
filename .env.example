#############################################
# Pine Backend — Environment Configuration
# Copy to .env and fill in real values.
# All variables are validated at boot by
# src/config/env.validation.ts — the app will
# refuse to start if any are missing/invalid.
#############################################

# ---- App ----
NODE_ENV=development
APP_NAME=pine-backend
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=v1
APP_TIMEZONE=Africa/Blantyre

# ---- CORS ----
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
CORS_CREDENTIALS=true

# ---- Database (PostgreSQL via Prisma) ----
DATABASE_URL=postgresql://pine:pine_dev_password@localhost:5432/pine_dev?schema=public
DATABASE_READ_REPLICA_URL=
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=pine.mw
JWT_AUDIENCE=pine-mobile-app

# ---- PIN / Password ----
PIN_ENCRYPTION_KEY=change-me-32-byte-hex-key-for-pin-encryption
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- OTP ----
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Rate Limiting ----
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ---- Object Storage (S3 / R2 / MinIO compatible) ----
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=pine_minio_admin
STORAGE_SECRET_ACCESS_KEY=change-me-minio-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_AVATARS=pine-avatars
STORAGE_BUCKET_KYC=pine-kyc-documents
STORAGE_BUCKET_REPORTS=pine-reports
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_UPLOAD_MB=10

# ---- Email ----
EMAIL_PROVIDER=smtp
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Pine <no-reply@pine.mw>

# ---- SMS ----
SMS_PROVIDER=africastalking
SMS_API_KEY=change-me
SMS_USERNAME=change-me
SMS_SENDER_ID=PINE

# ---- Payments: PayChangu ----
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_PUBLIC_KEY=change-me
PAYCHANGU_SECRET_KEY=change-me
PAYCHANGU_WEBHOOK_SECRET=change-me

# ---- Market Sync ----
MSE_DATA_SOURCE=scraper
MSE_BASE_URL=https://mse.co.mw
MSE_API_BASE_URL=
MSE_API_KEY=
MARKET_SYNC_CRON=*/5 8-16 * * 1-5
MARKET_TIMEZONE=Africa/Blantyre
MARKET_OPEN_TIME=10:00
MARKET_CLOSE_TIME=14:00

# ---- KYC / Identity Verification ----
KYC_MODEL_DIR=./models/insightface
KYC_FACE_MATCH_THRESHOLD=0.45
KYC_FACE_HIGH_CONFIDENCE=0.60
KYC_WEIGHT_OCR=0.30
KYC_WEIGHT_FACE=0.40
KYC_WEIGHT_IMAGE=0.15
KYC_WEIGHT_DOCUMENT=0.10
KYC_WEIGHT_FRAUD=0.05
KYC_THRESHOLD_APPROVE=0.85
KYC_THRESHOLD_REJECT=0.60
KYC_THRESHOLD_FACE=0.70
KYC_MAX_UPLOAD_SIZE_MB=10

# ---- Observability ----
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_PATH=/metrics

# ---- Security ----
TRUST_PROXY=true
BODY_LIMIT=1mb
COOKIE_SECRET=change-me-cookie-secret-min-32-chars
